<?xml version="1.0" encoding="UTF-8"?>
<!--
  VaxiCare Web Application Deployment Descriptor
  Standard XML Configuration file for Java EE / Jakarta Servlet Containers (Tomcat/Jetty/GlassFish)
  Syllabus requirement for KTU S3 Web & XML Technologies
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>VaxiCare Clinical Immunization Portal</display-name>
    <description>KTU S3 OOP Java Mini Project - Smart Vaccination &amp; Adverse Event Triage</description>

    <!-- Context Parameters -->
    <context-param>
        <param-name>appVersion</param-name>
        <param-value>2.0-KTU</param-value>
    </context-param>
    <context-param>
        <param-name>stateRegistryHub</param-name>
        <param-value>Kerala State Immunization Cell (Kozhikode/Thrissur Hub)</param-value>
    </context-param>

    <!-- 1. Authentication Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.vaxicare.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth</url-pattern>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- 2. Appointment Booking Servlet -->
    <servlet>
        <servlet-name>AppointmentServlet</servlet-name>
        <servlet-class>com.vaxicare.controller.AppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentServlet</servlet-name>
        <url-pattern>/appointment</url-pattern>
        <url-pattern>/book-slot</url-pattern>
    </servlet-mapping>

    <!-- 3. Adverse Event Following Immunization (AEFI) Servlet -->
    <servlet>
        <servlet-name>AefiServlet</servlet-name>
        <servlet-class>com.vaxicare.controller.AefiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AefiServlet</servlet-name>
        <url-pattern>/aefi</url-pattern>
        <url-pattern>/report-adverse-effect</url-pattern>
    </servlet-mapping>

    <!-- 4. Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.vaxicare.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 5. XML Certificate Export Servlet -->
    <servlet>
        <servlet-name>XmlExportServlet</servlet-name>
        <servlet-class>com.vaxicare.controller.XmlExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>XmlExportServlet</servlet-name>
        <url-pattern>/export-certificate</url-pattern>
        <url-pattern>/download-xml-certificate</url-pattern>
    </servlet-mapping>

    <!-- Session Timeout: 30 minutes -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
